services:
  metabase:
    image: ${metabase_image}
    container_name: metabase
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      MB_DB_TYPE: postgres
      MB_DB_CONNECTION_URI: "postgres://$${DB_HOST}:5432/$${DB_NAME}?sslmode=require"
      MB_DB_USER: $${DB_USER}
      MB_DB_PASS: $${DB_PASSWORD}
      JAVA_OPTS: "-Xmx1g"
      JAVA_TIMEZONE: America/Fortaleza
      MB_SITE_URL: $${SITE_URL:-}
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:3000/api/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 10
      start_period: 120s

  seed:
    image: postgres:17-alpine
    profiles: ["seed"]
    environment:
      PGHOST: $${DB_HOST}
      PGUSER: $${DB_USER}
      PGPASSWORD: $${DB_PASSWORD}
      PGSSLMODE: require
      APP_DB: $${DB_NAME}
      LEITURA_PASSWORD: $${LEITURA_PASSWORD}
    volumes:
      - ./seed-loja.sql:/seed/seed-loja.sql:ro
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        set -e
        psql -d postgres -v ON_ERROR_STOP=1 -tc "SELECT 1 FROM pg_database WHERE datname='$$APP_DB'" | grep -q 1 \
          || psql -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"$$APP_DB\""
        psql -d postgres -v ON_ERROR_STOP=1 -tc "SELECT 1 FROM pg_database WHERE datname='loja'" | grep -q 1 \
          || psql -d postgres -v ON_ERROR_STOP=1 -c "CREATE DATABASE loja"
        psql -d loja -v ON_ERROR_STOP=1 -v leitura_pw="$$LEITURA_PASSWORD" -f /seed/seed-loja.sql
        echo "Seed concluido: bancos '$$APP_DB' e 'loja' prontos."
