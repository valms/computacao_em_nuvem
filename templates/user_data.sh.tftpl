#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git curl
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/local/lib/docker/cli-plugins
curl -sSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

install -d -o ec2-user -g ec2-user -m 0755 /home/ec2-user/lab-metabase

cat > /home/ec2-user/lab-metabase/docker-compose.yml <<'EOF_COMPOSE'
${docker_compose}
EOF_COMPOSE

cat > /home/ec2-user/lab-metabase/seed-loja.sql <<'EOF_SEED'
${seed_sql}
EOF_SEED

cat > /home/ec2-user/lab-metabase/.env <<'EOF_ENV'
DB_HOST=${db_host}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
DB_NAME=${db_name}
LEITURA_PASSWORD=${leitura_password}
SITE_URL=${site_url}
EOF_ENV

chown -R ec2-user:ec2-user /home/ec2-user/lab-metabase
chmod 600 /home/ec2-user/lab-metabase/.env

cat > /etc/systemd/system/metabase-lab.service <<'EOF_SERVICE'
[Unit]
Description=Metabase lab Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ec2-user/lab-metabase
ExecStart=/usr/local/bin/metabase-lab-start
ExecStop=/usr/bin/docker compose down
User=ec2-user
Group=ec2-user

[Install]
WantedBy=multi-user.target
EOF_SERVICE

cat > /usr/local/bin/metabase-lab-start <<'EOF_START'
#!/bin/bash
set -euo pipefail
cd /home/ec2-user/lab-metabase
if [ ! -f .seed_done ]; then
  docker compose --profile seed run --rm seed
  touch .seed_done
fi
docker compose up -d
EOF_START

chmod +x /usr/local/bin/metabase-lab-start
systemctl daemon-reload
systemctl enable --now metabase-lab.service
